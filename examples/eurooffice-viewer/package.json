{
  "name": "@doc-converter/example-eurooffice-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Пример просмотрщика на движке Euro-Office: self-host сайта редактора из npm-частей и наша страница поверх Embed API.",
  "scripts": {
    "build": "vite build && node scripts/copy-assets.mjs",
    "assemble": "pnpm run build && node scripts/assemble.mjs",
    "serve": "node scripts/serve.mjs",
    "check": "node tools/viewer-check.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist site .cache"
  },
  "dependencies": {
    "@doc-converter/eurooffice": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
