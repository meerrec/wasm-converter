# Хост сайта редактора Euro-Office в дев-режиме: node scripts/eurooffice/serve.mjs
# Порт 5271 — из спайка. В прод-сборку значение утечь не может: Vite читает
# `.env.development` только в режиме разработки, и в проде база редактора
# выводится из `BASE_URL` (см. `src/lib/viewer_urls.ts`).
VITE_EUROOFFICE_BASE=http://127.0.0.1:5271/
