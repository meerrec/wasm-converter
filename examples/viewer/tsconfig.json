{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Страницы и компоненты — React-компоненты в `.tsx`, разметку собирает JSX.
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    // `node` нужен конфигу Vite: он читает файлы фикстур с диска.
    "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.ts"]
}
