node_modules/
dist/
target/
pkg/
.turbo/
# Артефакты публикации: собранный сайт Euro-Office и смонтированный `.pages/`.
# Якорь обязателен: без него правило съело бы `experiments/lowa-spike/build/`.
/build/
/.pages/
*.wasm
*.wasm.d.ts
coverage/
playwright-report/
test-results/
.DS_Store

# Cargo
Cargo.lock.orig
**/*.rs.bk

# WASM/JS bindings gen
crates/wasm/pkg/
packages/*/pkg/

# env / secrets
.env
.env.*
!.env.example
# ...кроме дев-адреса хоста Euro-Office: это не секрет, а часть рабочего контура
# (страница `#/eurooffice` без него уедет в прод-ветку кода). См. examples/viewer.
!examples/viewer/.env.development

# IDE
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Criterion
/criterion/

# Fuzz corpus (артефакты)
fuzz/corpus/
fuzz/artifacts/
fuzz/target/
oracle-out/
oracle-out-docx/

# TypeDoc API docs (сгенерированное: `pnpm docs:api`; .gitkeep держит каталог)
docs/api/*
!docs/api/.gitkeep

# LOWA-спайк (Спринт 13): артефакты чужих сборок — десятки МБ, лежат локально
# (`*.wasm` уже покрыт выше; `soffice.js`/`soffice.data` — нет)
experiments/lowa-spike/**/soffice.js
experiments/lowa-spike/**/soffice.data
experiments/lowa-spike/**/soffice.*.map
experiments/lowa-spike/vendor/

# ...кроме зеркала харнесса: оно в репозитории, через Git LFS (.gitattributes).
# Negation идёт после правил выше (позднее правило побеждает), а родительские каталоги
# не исключены, иначе `!` на файл внутри недействителен. `zeta.js` и
# `soffice.data.js.metadata` не исключены ни одним правилом — negation им не нужен.
!experiments/lowa-spike/public/lowa/soffice.js
!experiments/lowa-spike/public/lowa/soffice.data
!experiments/lowa-spike/public/lowa/soffice.wasm

# x2t-спайк (Спринт 13): релизные артефакты — в репозитории, через Git LFS
# (.gitattributes). `*.wasm` из правила выше покрывает сырой модуль; `x2t.js`,
# `x2t.js.br` и `x2t.wasm.br` ни одним правилом не исключены, negation им не нужен.
!packages/x2t/vendor/x2t.wasm

# Страница конвертера примера: сюда скрипт `examples/viewer/scripts/copy-x2t.mjs`
# кладёт копии артефактов x2t из вендорного каталога выше — источниками они не
# являются, в сборку уезжает копия.
examples/viewer/public/x2t/
test-fixtures/conf-xlsx/
