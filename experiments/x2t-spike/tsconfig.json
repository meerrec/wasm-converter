{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"]
  },
  // Точка входа пакета подключается по относительному пути (харнесс вне pnpm-workspace) — так
  // её типы проверяются вместе с харнессом; остальные файлы пакета tsc подтянет по импортам.
  "include": ["src", "vite.config.ts", "../../packages/x2t/src/index.ts"]
}
