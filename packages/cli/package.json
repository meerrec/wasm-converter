{
  "name": "@meerrec/cli",
  "version": "2.0.1",
  "description": "Command-line converter: DOCX to PDF/Markdown/HTML/text, XLSX to PDF, with a worker pool for batch runs.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meerrec/wasm-converter.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/meerrec/wasm-converter#readme",
  "bugs": {
    "url": "https://github.com/meerrec/wasm-converter/issues"
  },
  "type": "module",
  "bin": {
    "doc-converter": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@meerrec/core": "workspace:*",
    "@meerrec/wasm-docx": "workspace:*",
    "@meerrec/wasm-pdf": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
