{
  "name": "@meerrec/core",
  "version": "2.0.2",
  "description": "Core primitives: worker protocol, OffscreenCanvas glue, DisplayList transport.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meerrec/wasm-converter.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/meerrec/wasm-converter#readme",
  "bugs": {
    "url": "https://github.com/meerrec/wasm-converter/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./xlsx-worker": {
      "types": "./dist/xlsx_worker.d.ts",
      "import": "./dist/xlsx_worker.js"
    },
    "./docx-worker": {
      "types": "./dist/docx_worker.d.ts",
      "import": "./dist/docx_worker.js"
    },
    "./pptx-worker": {
      "types": "./dist/pptx_worker.d.ts",
      "import": "./dist/pptx_worker.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/xlsx_worker.js",
    "./dist/xlsx_worker.cjs",
    "./dist/docx_worker.js",
    "./dist/docx_worker.cjs",
    "./dist/pptx_worker.js",
    "./dist/pptx_worker.cjs"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@meerrec/wasm": "^2.0.2",
    "@opentelemetry/api": "^1.0.0"
  },
  "devDependencies": {
    "@meerrec/wasm-docx": "^2.0.2",
    "@meerrec/wasm-pdf": "^2.0.2",
    "@opentelemetry/sdk-trace-base": "^1.0.0",
    "@meerrec/wasm-pptx": "^2.0.2",
    "@meerrec/wasm-pptx-pdf": "^2.0.2",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
