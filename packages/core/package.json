{
  "name": "@meerrec/core",
  "version": "2.1.0",
  "description": "Core primitives: worker protocol, OffscreenCanvas glue, DisplayList transport.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meerrec/wasm-converter.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/meerrec/wasm-converter#readme",
  "bugs": {
    "url": "https://github.com/meerrec/wasm-converter/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./xlsx-worker": {
      "types": "./dist/xlsx_worker.d.ts",
      "import": "./dist/xlsx_worker.js"
    },
    "./docx-worker": {
      "types": "./dist/docx_worker.d.ts",
      "import": "./dist/docx_worker.js"
    },
    "./pptx-worker": {
      "types": "./dist/pptx_worker.d.ts",
      "import": "./dist/pptx_worker.js"
    },
    "./xlsb-worker": {
      "types": "./dist/xlsb_worker.d.ts",
      "import": "./dist/xlsb_worker.js"
    },
    "./ods-worker": {
      "types": "./dist/ods_worker.d.ts",
      "import": "./dist/ods_worker.js"
    },
    "./odp-worker": {
      "types": "./dist/odp_worker.d.ts",
      "import": "./dist/odp_worker.js"
    },
    "./odt-worker": {
      "types": "./dist/odt_worker.d.ts",
      "import": "./dist/odt_worker.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/xlsx_worker.js",
    "./dist/xlsx_worker.cjs",
    "./dist/docx_worker.js",
    "./dist/docx_worker.cjs",
    "./dist/pptx_worker.js",
    "./dist/pptx_worker.cjs",
    "./dist/xlsb_worker.js",
    "./dist/xlsb_worker.cjs",
    "./dist/ods_worker.js",
    "./dist/ods_worker.cjs",
    "./dist/odp_worker.js",
    "./dist/odp_worker.cjs",
    "./dist/odt_worker.js",
    "./dist/odt_worker.cjs"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@meerrec/wasm": "workspace:*",
    "@opentelemetry/api": "^1.0.0"
  },
  "devDependencies": {
    "@meerrec/wasm-docx": "workspace:*",
    "@meerrec/wasm-pdf": "workspace:*",
    "@opentelemetry/sdk-trace-base": "^1.0.0",
    "@meerrec/wasm-pptx": "workspace:*",
    "@meerrec/wasm-pptx-pdf": "workspace:*",
    "@meerrec/wasm-xlsb": "workspace:*",
    "@meerrec/wasm-ods": "workspace:*",
    "@meerrec/wasm-odp": "workspace:*",
    "@meerrec/wasm-odt": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
