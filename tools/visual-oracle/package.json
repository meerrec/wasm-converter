{
  "name": "@meerrec/visual-oracle",
  "version": "0.1.0",
  "private": true,
  "description": "Offline visual oracle for the strict viewer certification program: corpus loading, manifest validation, reference import, capture, comparison and reporting.",
  "type": "module",
  "bin": {
    "visual-oracle": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
