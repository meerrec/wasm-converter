    "clean": "rm -rf dist"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pngjs": "^6.0.5",
    "playwright": "^1.63.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
